<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{% if page.layout == "post" %}{{ page.title }} | {{ site.title }}{% else %}{{ site.title }} | {{ page.title }}{% endif %}</title>
  {% if page.layout == "post" and content contains 'fetchpriority="high"' %}
    {% assign lead_img = content | split: '<img ' | slice: 1 | first | split: '>' | first %}
    {% if lead_img contains 'fetchpriority="high"' %}
      {% if lead_img contains 'src="https://images.immediate.co.uk/' %}<link rel="preconnect" href="https://images.immediate.co.uk" />{% endif %}
      {% assign lead_src = lead_img | split: 'src="' | last | split: '"' | first %}
      <link rel="preload" as="image"{% if site.data.mobile_covers[lead_src] %} media="(min-width: 701px)" type="image/avif"{% endif %} fetchpriority="high" href="{{ lead_img | split: 'src="' | last | split: '"' | first }}"{% if lead_img contains 'srcset="' %} imagesrcset="{{ lead_img | split: 'srcset="' | last | split: '"' | first }}" imagesizes="{{ lead_img | split: 'sizes="' | last | split: '"' | first }}"{% endif %} />
    {% endif %}
  {% else %}
    <link rel="preload" href="/assets/fonts/newsreader-text-normal.woff2" as="font" type="font/woff2" crossorigin />
  {% endif %}
  <style>
    {% include css/fonts.css %}
    {% if page.layout == "post" %}{% include css/post.css %}{% else %}{% include css/blog.css %}{% endif %}
    {% include css/common.css %}
  </style>
  <script defer src="{{site.baseurl}}/assets/js/categories.js"></script>
  {% if page.layout == "post" %}
  <script defer src="{{site.baseurl}}/assets/js/lbox.js"></script>
  {% endif %}
  <meta name="description" content="{{ page.description }}" />
  <!-- social share / open graph -->
  {% assign share_image = page.feature_image | default: "/assets/img/profile.webp" %}
  <meta property="og:type" content="{% if page.layout == 'post' %}article{% else %}website{% endif %}" />
  <meta property="og:title" content="{{ page.title | default: site.title }}" />
  <meta property="og:description" content="{{ page.description }}" />
  <meta property="og:url" content="{{ page.url | absolute_url }}" />
  <meta property="og:image" content="{{ share_image | absolute_url }}" />
  <meta name="twitter:card" content="{% if page.feature_image %}summary_large_image{% else %}summary{% endif %}" />
  <meta name="twitter:title" content="{{ page.title | default: site.title }}" />
  <meta name="twitter:description" content="{{ page.description }}" />
  <meta name="twitter:image" content="{{ share_image | absolute_url }}" />
  <meta name="twitter:creator" content="@TheMajd_" />
  <link rel="apple-touch-icon" sizes="180x180" href="{{site.baseurl}}/assets/favicon/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="{{site.baseurl}}/assets/favicon/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="{{site.baseurl}}/assets/favicon/favicon-16x16.png">
  <link rel="manifest" href="{{site.baseurl}}/assets/favicon/site.webmanifest">
  <!-- Google tag (gtag.js) -->
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-8MK3YFTLCD');
    window.addEventListener('load', function () {
      var script = document.createElement('script');
      script.async = true;
      script.src = 'https://www.googletagmanager.com/gtag/js?id=G-8MK3YFTLCD';
      document.head.appendChild(script);
    }, { once: true });
  </script>

</head>
